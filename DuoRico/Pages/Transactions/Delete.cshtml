@page "{id:guid}/{type:alpha}"

@model DuoRico.Pages_Transactions.DeleteModel

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Excluir</title>
</head>
<body>
    <form method="post">
        <input type="hidden" asp-for="Transaction.Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-page="Index" asp-route-selectMonth="@Model.ReturnMonth" asp-route-selectYear="@Model.ReturnYear" asp-route-type="@Model.Type" class="btn btn-secondary">Voltar para a lista</a>
    </form>
</body>
</html>
